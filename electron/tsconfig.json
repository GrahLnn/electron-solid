{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    "outDir": "../dist-electron",
    "rootDir": ".",
    "noEmit": false,
    "noEmitOnError": true,
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "types": ["node", "electron"]
  },
  "include": ["*.ts"]
}
